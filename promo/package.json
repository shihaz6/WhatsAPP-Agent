{
  "name": "catalyst-promo",
  "private": true,
  "version": "0.1.0",
  "description": "Catalyst promo video (1920x1080 + 1080x1920), made with Remotion",
  "scripts": {
    "soundtrack": "node scripts/make-soundtrack.mjs",
    "studio": "npm run soundtrack && remotion studio",
    "render:landscape": "remotion render Promo-Landscape out/catalyst-promo-landscape.mp4",
    "render:portrait": "remotion render Promo-Portrait out/catalyst-promo-vertical.mp4",
    "render": "npm run soundtrack && npm run render:landscape && npm run render:portrait",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
