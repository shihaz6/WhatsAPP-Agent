{
  "name": "alchemyx-catalyst-video",
  "private": true,
  "version": "0.1.0",
  "description": "Promo video of the AlchemyX Catalyst dashboard, made with Remotion",
  "scripts": {
    "soundtrack": "node scripts/make-soundtrack.mjs",
    "studio": "npm run soundtrack && remotion studio",
