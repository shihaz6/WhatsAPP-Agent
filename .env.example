# Copy to .env and fill in. .env is gitignored; this example file is committed.

# Meta app secret (App settings -> Basic). Enables webhook signature checks.
APP_SECRET=

# Required: any secret string; must match the verify token in the Meta console.
VERIFY_TOKEN=

# WhatsApp -> API Setup page. Both are needed to send replies.
PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# GRAPH_API_VERSION=v24.0
# PORT=3000

# Groq (AI model). Optional model override; default openai/gpt-oss-120b.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# AlchemyX Catalyst dashboard (/admin). Any long random string; you type it in to sign in.
# Leave empty to switch the dashboard off. Generate one: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Optional: ignore chat history before this ISO time (UTC), e.g. after changing what the bot does.
# HISTORY_SINCE=2026-11-13T20:40:01Z
