# Copy to .env and fill in. .env is gitignored; this example file is committed.

# Meta app secret (App settings -> Basic). Enables webhook signature checks.
APP_SECRET=

# Required: any secret string; must match the verify token in the Meta console.
VERIFY_TOKEN=

# WhatsApp -> API Setup page. Both are needed to send replies.
PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# GRAPH_API_VERSION=v24.0
# PORT=3000

# AI model. AI_PROVIDER is gemini, nvidia, openrouter or groq; unset = gemini when GEMINI_API_KEY is set, otherwise groq.
# AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# NVIDIA (build.nvidia.com), e.g. Kimi. Tested 20 Nov 2026: requests queued for 2+ minutes.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=moonshotai/kimi-k3.1-pro
# NVIDIA_REASONING_EFFORT=low
# OpenRouter: free models end in ":free" (no cost, daily request limits).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# AlchemyX Catalyst dashboard (/admin). Any long random string; you type it in to sign in.
# Leave empty and the dashboard is OPEN to anyone who can reach the server (fine only on your own computer). Generate one: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Optional: ignore chat history before this ISO time (UTC), e.g. after changing what the bot does.
# HISTORY_SINCE=2026-11-13T20:40:01Z
